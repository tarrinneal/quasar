{
  "name": "codeium-dev",
  "displayName": "Quasar",
  "description": "Comprehension-first GitHub PR & local branch review tool. Features interactive CliffsNotes study guides with expandable code snippets, clickable SVG flowcharts, logical reading tours, native side-by-side diffs, inline Ask-Quasar comment threads, and 1-click GitHub Review publishing.",
  "version": "1.2.4",
  "publisher": "codeium",
  "icon": "media/quasar-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarrinneal/quasar.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:quasar.cliffsNotesTree",
    "onView:quasar.commentsTree",
    "onView:quasar.checksTree"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quasar",
          "title": "Quasar",
          "icon": "media/review-icon.svg"
        }
      ]
    },
    "views": {
      "quasar": [
        {
          "id": "quasar.cliffsNotesTree",
          "name": "CliffsNotes & Reading Tour",
          "icon": "media/review-icon.svg",
          "contextualTitle": "CliffsNotes & Tour"
        },
        {
          "id": "quasar.commentsTree",
          "name": "Review Comments & Cart",
          "contextualTitle": "Review Comments"
        },
        {
          "id": "quasar.checksTree",
          "name": "Checks & Learned Preferences",
          "contextualTitle": "Checks & Preferences",
          "visibility": "hidden",
          "when": "quasar.showChecksTree"
        }
      ]
    },
    "commands": [
      {
        "command": "quasar.toggleChecksTree",
        "title": "Show / Hide Checks & Learned Preferences Panel",
        "category": "Quasar",
        "icon": "$(eye)"
      },
      {
        "command": "quasar.openMenu",
        "title": "Open Quasar Sidebar & Menu...",
        "category": "Quasar",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "quasar.loadPrFromUrl",
        "title": "Review PR from GitHub URL...",
        "category": "Quasar",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "quasar.reviewLocalBranch",
        "title": "Review Local Branch or Diff...",
        "category": "Quasar",
        "icon": "$(git-branch)"
      },
      {
        "command": "quasar.selectEffortLevel",
        "title": "Set Review Mode & Effort (Full Guide vs Comments Only / Low / Medium / High)...",
        "category": "Quasar",
        "icon": "$(zap)"
      },
      {
        "command": "quasar.startTutorial",
        "title": "Interactive Tutorial: Try Quasar in a Sandbox PR...",
        "category": "Quasar",
        "icon": "$(mortar-board)"
      },
      {
        "command": "quasar.openCliffsNotesGuide",
        "title": "Open Full CliffsNotes Study Guide",
        "category": "Quasar",
        "icon": "$(book)"
      },
      {
        "command": "quasar.nextTourStop",
        "title": "Next CliffsNotes Tour Stop",
        "category": "Quasar",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quasar.prevTourStop",
        "title": "Previous CliffsNotes Tour Stop",
        "category": "Quasar",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quasar.openTourStop",
        "title": "Open Tour Stop in Diff Editor",
        "category": "Quasar",
        "icon": "$(diff)"
      },
      {
        "command": "quasar.jumpToThread",
        "title": "Jump to Comment Thread in Diff",
        "category": "Quasar",
        "icon": "$(comment)"
      },
      {
        "command": "quasar.askInComment",
        "title": "Ask Quasar About This Code",
        "category": "Quasar",
        "icon": "$(sparkle)"
      },
      {
        "command": "quasar.askAtLine",
        "title": "Ask Quasar in Comment Thread...",
        "category": "Quasar",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "quasar.stageNewComment",
        "title": "Stage Review Comment for GitHub",
        "category": "Quasar",
        "icon": "$(check)"
      },
      {
        "command": "quasar.stageThread",
        "title": "Stage for GitHub Review",
        "category": "Quasar",
        "icon": "$(check)"
      },
      {
        "command": "quasar.unstageThread",
        "title": "Unstage from GitHub Review (Keep as Draft)",
        "category": "Quasar",
        "icon": "$(history)"
      },
      {
        "command": "quasar.dismissThread",
        "title": "Remove / Dismiss Comment",
        "category": "Quasar",
        "icon": "$(trash)"
      },
      {
        "command": "quasar.editDraftComment",
        "title": "Edit Draft GitHub Comment...",
        "category": "Quasar",
        "icon": "$(edit)"
      },
      {
        "command": "quasar.commentOnComment",
        "title": "Ask Agent to Change Comment",
        "category": "Quasar",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "quasar.calibrateFindingPreference",
        "title": "Calibrate Preference on Uncertain Feedback...",
        "category": "Quasar",
        "icon": "$(question)"
      },
      {
        "command": "quasar.upvoteFinding",
        "title": "Helpful Feedback (More Like This)",
        "category": "Quasar",
        "icon": "$(thumbsup)"
      },
      {
        "command": "quasar.downvoteFinding",
        "title": "Not Useful Feedback (Less Like This...)",
        "category": "Quasar",
        "icon": "$(thumbsdown)"
      },
      {
        "command": "quasar.giveMetaFeedback",
        "title": "Teach Quasar / Give Feedback on This Feedback...",
        "category": "Quasar",
        "icon": "$(lightbulb-sparkle)"
      },
      {
        "command": "quasar.importReviewSkill",
        "title": "Import Premade Review Skill as Starting Point...",
        "category": "Quasar",
        "icon": "$(sparkle)"
      },
      {
        "command": "quasar.manageReviewAgents",
        "title": "Add / Manage Review Subagents (review-*)...",
        "category": "Quasar",
        "icon": "$(organization)"
      },
      {
        "command": "quasar.managePreferences",
        "title": "Manage & Calibrate Reviewer Preferences...",
        "category": "Quasar",
        "icon": "$(settings-gear)"
      },
      {
        "command": "quasar.openPreferencesGuide",
        "title": "Open Learned Preferences Guide (PREFERENCES.md)",
        "category": "Quasar",
        "icon": "$(notebook)"
      },
      {
        "command": "quasar.fixSelectedComments",
        "title": "Fix Selected Comments with Agent...",
        "category": "Quasar",
        "icon": "$(wrench)"
      },
      {
        "command": "quasar.toggleSelectForFix",
        "title": "Queue / Unqueue Comment for Agent Fix",
        "category": "Quasar",
        "icon": "$(tools)"
      },
      {
        "command": "quasar.fixSingleComment",
        "title": "Fix This Issue with Quasar Now...",
        "category": "Quasar",
        "icon": "$(wrench)"
      },
      {
        "command": "quasar.configureGithubToken",
        "title": "Configure GitHub API Key / Personal Access Token...",
        "category": "Quasar",
        "icon": "$(key)"
      },
      {
        "command": "quasar.exportPendingReview",
        "title": "Publish / Export Review to GitHub (as You)...",
        "category": "Quasar",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "quasar.refreshSession",
        "title": "Refresh Review Session",
        "category": "Quasar",
        "icon": "$(refresh)"
      },
      {
        "command": "quasar.resetReview",
        "title": "Reset / Re-Run Branch or PR Review...",
        "category": "Quasar",
        "icon": "$(debug-restart)"
      },
      {
        "command": "quasar.closeReview",
        "title": "Close Active Review & Clear IDE Annotations",
        "category": "Quasar",
        "icon": "$(close)"
      },
      {
        "command": "quasar.checkoutPrBranch",
        "title": "Switch Local Repository to Active PR Branch...",
        "category": "Quasar",
        "icon": "$(git-branch)"
      },
      {
        "command": "quasar.switchPastReview",
        "title": "Past Reviews / Switch Review Session...",
        "category": "Quasar",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "quasar.nextTourStop",
        "key": "alt+down",
        "mac": "alt+down",
        "when": "editorTextFocus"
      },
      {
        "command": "quasar.prevTourStop",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "quasar.reviewLocalBranch",
          "group": "navigation@1"
        },
        {
          "command": "quasar.loadPrFromUrl",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "quasar.loadPrFromUrl",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@1"
        },
        {
          "command": "quasar.reviewLocalBranch",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@2"
        },
        {
          "command": "quasar.switchPastReview",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@3"
        },
        {
          "command": "quasar.openCliffsNotesGuide",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@4"
        },
        {
          "command": "quasar.nextTourStop",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@5"
        },
        {
          "command": "quasar.resetReview",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@6"
        },
        {
          "command": "quasar.closeReview",
          "when": "view == quasar.cliffsNotesTree",
          "group": "navigation@7"
        },
        {
          "command": "quasar.fixSelectedComments",
          "when": "view == quasar.commentsTree",
          "group": "navigation@0"
        },
        {
          "command": "quasar.exportPendingReview",
          "when": "view == quasar.commentsTree",
          "group": "navigation@1"
        },
        {
          "command": "quasar.configureGithubToken",
          "when": "view == quasar.commentsTree",
          "group": "navigation@2"
        },
        {
          "command": "quasar.managePreferences",
          "when": "view == quasar.commentsTree",
          "group": "navigation@3"
        },
        {
          "command": "quasar.refreshSession",
          "when": "view == quasar.commentsTree",
          "group": "navigation@4"
        },
        {
          "command": "quasar.resetReview",
          "when": "view == quasar.commentsTree",
          "group": "navigation@5"
        },
        {
          "command": "quasar.closeReview",
          "when": "view == quasar.commentsTree",
          "group": "navigation@6"
        },
        {
          "command": "quasar.importReviewSkill",
          "when": "view == quasar.checksTree",
          "group": "navigation@1"
        },
        {
          "command": "quasar.managePreferences",
          "when": "view == quasar.checksTree",
          "group": "navigation@2"
        },
        {
          "command": "quasar.openPreferencesGuide",
          "when": "view == quasar.checksTree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "quasar.resetReview",
          "when": "view == quasar.cliffsNotesTree && viewItem == pr-header",
          "group": "inline@1"
        },
        {
          "command": "quasar.closeReview",
          "when": "view == quasar.cliffsNotesTree && viewItem == pr-header",
          "group": "inline@2"
        },
        {
          "command": "quasar.calibrateFindingPreference",
          "when": "view == quasar.commentsTree && viewItem == thread-uncertain",
          "group": "inline@0"
        },
        {
          "command": "quasar.commentOnComment",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged || viewItem == thread-existing)",
          "group": "inline@0_change"
        },
        {
          "command": "quasar.fixSingleComment",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged || viewItem == thread-existing)",
          "group": "inline@0_fix"
        },
        {
          "command": "quasar.stageThread",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain)",
          "group": "inline@1"
        },
        {
          "command": "quasar.upvoteFinding",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "inline@2"
        },
        {
          "command": "quasar.downvoteFinding",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "inline@3"
        },
        {
          "command": "quasar.giveMetaFeedback",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "inline@4"
        },
        {
          "command": "quasar.dismissThread",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "inline@5"
        },
        {
          "command": "quasar.commentOnComment",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged || viewItem == thread-existing)",
          "group": "1_modify@0_change"
        },
        {
          "command": "quasar.toggleSelectForFix",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged || viewItem == thread-existing)",
          "group": "1_modify@0"
        },
        {
          "command": "quasar.editDraftComment",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "1_modify@1"
        },
        {
          "command": "quasar.unstageThread",
          "when": "view == quasar.commentsTree && viewItem == thread-staged",
          "group": "1_modify@2"
        },
        {
          "command": "quasar.dismissThread",
          "when": "view == quasar.commentsTree && (viewItem == thread-candidate || viewItem == thread-uncertain || viewItem == thread-staged)",
          "group": "1_modify@3"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "quasar.calibrateFindingPreference",
          "when": "commentController == quasar && commentThread =~ /uncertain/",
          "group": "inline@0"
        },
        {
          "command": "quasar.commentOnComment",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa|existing/",
          "group": "inline@0_change"
        },
        {
          "command": "quasar.toggleSelectForFix",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa|existing/",
          "group": "inline@0_queue"
        },
        {
          "command": "quasar.fixSingleComment",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa|existing/",
          "group": "inline@0_fix"
        },
        {
          "command": "quasar.stageThread",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|qa/",
          "group": "inline@1"
        },
        {
          "command": "quasar.upvoteFinding",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged/",
          "group": "inline@2"
        },
        {
          "command": "quasar.downvoteFinding",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged/",
          "group": "inline@3"
        },
        {
          "command": "quasar.giveMetaFeedback",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa/",
          "group": "inline@4"
        },
        {
          "command": "quasar.editDraftComment",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged/",
          "group": "inline@5"
        },
        {
          "command": "quasar.dismissThread",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa/",
          "group": "inline@6"
        },
        {
          "command": "quasar.unstageThread",
          "when": "commentController == quasar && commentThread =~ /staged/",
          "group": "inline@7"
        }
      ],
      "comments/comment/title": [
        {
          "command": "quasar.commentOnComment",
          "when": "commentController == quasar",
          "group": "inline@1"
        },
        {
          "command": "quasar.editDraftComment",
          "when": "commentController == quasar",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "quasar.commentOnComment",
          "when": "commentController == quasar && commentThread =~ /candidate|uncertain|staged|qa|existing/",
          "group": "inline@0"
        },
        {
          "command": "quasar.askInComment",
          "when": "commentController == quasar",
          "group": "inline@1"
        },
        {
          "command": "quasar.giveMetaFeedback",
          "when": "commentController == quasar",
          "group": "inline@2"
        },
        {
          "command": "quasar.stageNewComment",
          "when": "commentController == quasar",
          "group": "inline@3"
        }
      ]
    },
    "markdown.previewScripts": [
      "./media/mermaid-preview.js"
    ]
  }
}
